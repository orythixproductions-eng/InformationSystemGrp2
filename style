/* =========================================================
   INFORMATION SYSTEMS — FUTURISTIC TECHNOLOGY PRESENTATION
   ========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Arial,sans-serif;
    scroll-behavior:smooth;
}

:root{
    --bg:#03070d;
    --bg2:#07111d;

    --panel:rgba(7,20,34,.78);
    --panel-light:rgba(12,31,49,.72);
    --panel-hover:rgba(15,39,61,.85);

    --cyan:#00e5ff;
    --blue:#168cff;
    --green:#00ff9d;
    --yellow:#ffd43b;
    --purple:#8b5cf6;

    --text:#e8f7ff;
    --muted:#8ba4b7;
    --soft:#b9cedb;

    --border:rgba(0,229,255,.18);
    --border-bright:rgba(0,229,255,.42);

    --shadow:
        0 25px 70px rgba(0,0,0,.38);

    --glow:
        0 0 25px rgba(0,229,255,.12);
}


/* =========================================================
   BODY
   ========================================================= */

body{

    min-height:100vh;

    background:
        radial-gradient(
            circle at 10% 15%,
            rgba(0,229,255,.09),
            transparent 25%
        ),
        radial-gradient(
            circle at 90% 80%,
            rgba(22,140,255,.12),
            transparent 30%
        ),
        radial-gradient(
            circle at 50% 50%,
            rgba(139,92,246,.035),
            transparent 40%
        ),
        linear-gradient(
            135deg,
            #02060b,
            #06111d,
            #030911
        );

    background-size:
        100% 100%,
        100% 100%,
        100% 100%,
        220% 220%;

    animation:
        systemBackground 20s ease infinite;

    color:var(--text);

    overflow-x:hidden;
}


/* =========================================================
   ANIMATED GRID
   ========================================================= */

body::before{

    content:"";

    position:fixed;

    inset:0;

    background-image:
        linear-gradient(
            rgba(0,229,255,.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0,229,255,.035) 1px,
            transparent 1px
        );

    background-size:45px 45px;

    mask-image:
        linear-gradient(
            to bottom,
            black 0%,
            rgba(0,0,0,.7) 65%,
            transparent 100%
        );

    pointer-events:none;

    z-index:-10;

    animation:gridMove 16s linear infinite;
}


@keyframes gridMove{

    from{
        background-position:0 0;
    }

    to{
        background-position:45px 45px;
    }
}


@keyframes systemBackground{

    0%{
        background-position:
            0% 0%,
            100% 100%,
            50% 50%,
            0% 50%;
    }

    50%{
        background-position:
            20% 30%,
            80% 70%,
            45% 55%,
            100% 50%;
    }

    100%{
        background-position:
            0% 0%,
            100% 100%,
            50% 50%,
            0% 50%;
    }
}


/* =========================================================
   DIGITAL SCANLINES
   ========================================================= */

body::after{

    content:"";

    position:fixed;

    inset:0;

    background:
        repeating-linear-gradient(
            to bottom,
            transparent 0px,
            transparent 3px,
            rgba(0,229,255,.018) 4px
        );

    pointer-events:none;

    z-index:9999;

    mix-blend-mode:screen;
}


/* =========================================================
   SLIDES
   ========================================================= */

.slide{

    width:100vw;
    min-height:100vh;

    padding:
        125px
        8%
        95px;

    display:flex;
    flex-direction:column;
    justify-content:center;

    position:relative;

    overflow:hidden;

    isolation:isolate;

    border-bottom:
        1px solid rgba(0,229,255,.08);

    animation:
        slideEnter .8s ease both;
}


.slide::before{

    content:"";

    position:absolute;

    width:460px;
    height:460px;

    right:-210px;
    top:50%;

    transform:translateY(-50%);

    border:
        1px solid rgba(0,229,255,.11);

    border-radius:50%;

    box-shadow:
        0 0 0 25px rgba(0,229,255,.018),
        0 0 0 55px rgba(0,229,255,.012),
        0 0 80px rgba(0,229,255,.025);

    animation:
        radarRotate 28s linear infinite;

    pointer-events:none;

    z-index:-2;
}


.slide::after{

    content:"";

    position:absolute;

    width:300px;
    height:200px;

    right:35px;
    top:100px;

    background:

        linear-gradient(
            90deg,
            transparent 49%,
            rgba(0,229,255,.18) 50%,
            transparent 51%
        ),

        linear-gradient(
            0deg,
            transparent 49%,
            rgba(0,229,255,.18) 50%,
            transparent 51%
        );

    background-size:40px 40px;

    opacity:.18;

    pointer-events:none;

    z-index:-1;
}


@keyframes slideEnter{

    from{
        opacity:0;
        transform:translateY(35px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}


@keyframes radarRotate{

    from{
        transform:
            translateY(-50%)
            rotate(0deg);
    }

    to{
        transform:
            translateY(-50%)
            rotate(360deg);
    }
}


/* =========================================================
   SLIDE INNER
   ========================================================= */

.slide-inner{

    width:100%;

    max-width:1450px;

    margin:auto;

    position:relative;

    z-index:2;
}


/* =========================================================
   COVER
   ========================================================= */

.cover{

    text-align:center;

    align-items:center;

    background:
        radial-gradient(
            circle at center,
            rgba(0,229,255,.09),
            transparent 38%
        );
}


.cover .slide-inner{

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;
}


.cover h1{

    font-size:
        clamp(
            55px,
            8vw,
            105px
        );

    line-height:1;

    letter-spacing:-4px;

    margin-bottom:25px;

    color:white;

    text-shadow:
        0 0 15px rgba(0,229,255,.28),
        0 0 50px rgba(0,229,255,.08);

    animation:
        titleGlitch 5s infinite;
}


.cover h1::after{

    content:"_";

    color:var(--cyan);

    animation:
        cursorBlink 1s infinite;
}


.cover-subtitle{

    max-width:800px;

    color:var(--muted);

    font-size:20px;

    line-height:1.8;

    letter-spacing:.5px;
}


.group-tag{

    margin-top:30px;

    padding:10px 22px;

    border:
        1px solid rgba(0,229,255,.28);

    border-radius:4px;

    background:
        rgba(0,229,255,.045);

    color:var(--cyan);

    font-family:monospace;

    font-size:12px;

    font-weight:bold;

    letter-spacing:3px;

    box-shadow:
        0 0 25px rgba(0,229,255,.06);
}


@keyframes cursorBlink{

    0%,50%{
        opacity:1;
    }

    51%,100%{
        opacity:0;
    }
}


@keyframes titleGlitch{

    0%,92%,100%{
        transform:translate(0);
    }

    93%{
        transform:translate(-2px,1px);
    }

    94%{
        transform:translate(2px,-1px);
    }

    95%{
        transform:translate(0);
    }
}


/* =========================================================
   SYSTEM LABEL / EYEBROW
   ========================================================= */

.eyebrow,
.system-label{

    display:inline-flex;

    align-items:center;

    gap:10px;

    width:max-content;

    margin-bottom:22px;

    padding:
        8px
        14px;

    border:
        1px solid rgba(0,229,255,.25);

    border-radius:4px;

    background:
        rgba(0,229,255,.035);

    color:var(--cyan);

    font-family:monospace;

    font-size:11px;

    font-weight:bold;

    letter-spacing:3px;

    text-transform:uppercase;

    box-shadow:
        inset 0 0 20px rgba(0,229,255,.025);
}


.eyebrow::before,
.system-label::before{

    content:"";

    width:7px;
    height:7px;

    border-radius:50%;

    background:var(--green);

    box-shadow:
        0 0 10px var(--green);

    animation:
        statusBlink 1.5s infinite;
}


@keyframes statusBlink{

    0%,100%{
        opacity:1;
    }

    50%{
        opacity:.3;
    }
}


/* =========================================================
   HEADINGS
   ========================================================= */

h1,
h2,
h3{

    font-weight:700;
}


h2{

    position:relative;

    font-size:
        clamp(
            34px,
            5vw,
            58px
        );

    line-height:1.08;

    margin-bottom:32px;

    padding-left:22px;

    color:white;

    letter-spacing:-1.5px;

    text-shadow:
        0 0 25px rgba(0,229,255,.06);
}


h2::before{

    content:"";

    position:absolute;

    left:0;
    top:4px;

    width:5px;
    height:84%;

    background:
        linear-gradient(
            to bottom,
            var(--cyan),
            var(--blue)
        );

    box-shadow:
        0 0 15px rgba(0,229,255,.65);
}


h2::after{

    content:"// INFORMATION_SYSTEM";

    display:block;

    margin-top:13px;

    color:var(--cyan);

    font-family:monospace;

    font-size:10px;

    font-weight:600;

    letter-spacing:3px;

    opacity:.6;
}


/* =========================================================
   GENERAL TEXT
   ========================================================= */

p{

    color:#c9dce8;

    line-height:1.8;
}


/* =========================================================
   TOPIC LAYOUT
   ========================================================= */

.topic-layout{

    display:grid;

    grid-template-columns:
        minmax(0,1.2fr)
        minmax(340px,.8fr);

    gap:65px;

    align-items:center;
}


.topic-content{

    max-width:850px;
}


.definition{

    font-size:22px;

    line-height:1.8;

    margin-bottom:18px;

    padding:27px 30px;

    background:
        linear-gradient(
            135deg,
            rgba(8,25,42,.9),
            rgba(5,15,27,.72)
        );

    border:
        1px solid var(--border);

    border-left:
        3px solid var(--cyan);

    border-radius:5px;

    box-shadow:
        var(--shadow),
        inset 0 0 30px rgba(0,229,255,.015);

    backdrop-filter:blur(15px);

    position:relative;
}


.definition::before{

    content:"DEFINITION";

    position:absolute;

    top:-9px;
    left:18px;

    padding:2px 8px;

    background:var(--bg);

    color:var(--cyan);

    font-family:monospace;

    font-size:9px;

    letter-spacing:2px;
}


/* =========================================================
   EXPLANATION
   ========================================================= */

.explanation{

    margin-top:25px;

    padding:25px 28px;

    border:
        1px solid rgba(0,229,255,.13);

    border-left:
        3px solid var(--blue);

    border-radius:
        5px 16px 16px 5px;

    background:
        linear-gradient(
            135deg,
            rgba(0,229,255,.045),
            rgba(22,140,255,.018)
        );

    box-shadow:
        0 20px 45px rgba(0,0,0,.22);
}


.explanation span{

    display:block;

    margin-bottom:10px;

    color:var(--cyan);

    font-family:monospace;

    font-size:10px;

    font-weight:bold;

    letter-spacing:3px;
}


.explanation p{

    font-size:17px;

    color:#c8dbe7;
}


/* =========================================================
   SOURCE LINKS UNDER EXPLANATIONS
   ========================================================= */

.source{

    margin-top:15px;

    font-size:12px;

    color:#71899a;
}


.source::before{

    content:"SOURCE:// ";

    color:var(--green);

    font-family:monospace;

    font-weight:bold;

    letter-spacing:1px;
}


.source a{

    display:inline-flex;

    align-items:center;

    gap:5px;

    padding:4px 8px;

    color:var(--cyan);

    text-decoration:none;

    border-bottom:
        1px dashed rgba(0,229,255,.35);

    transition:
        .25s ease;
}


.source a:hover{

    color:white;

    border-bottom-color:var(--cyan);

    text-shadow:
        0 0 10px rgba(0,229,255,.65);

    transform:translateX(3px);
}


/* =========================================================
   EXAMPLE PANEL
   ========================================================= */

.example-box{

    min-height:400px;

    padding:38px;

    position:relative;

    display:flex;

    flex-direction:column;

    justify-content:center;

    overflow:hidden;

    background:
        radial-gradient(
            circle at 85% 10%,
            rgba(0,229,255,.13),
            transparent 32%
        ),
        linear-gradient(
            145deg,
            rgba(10,28,45,.9),
            rgba(5,15,27,.82)
        );

    border:
        1px solid rgba(0,229,255,.22);

    border-radius:8px;

    box-shadow:
        0 30px 80px rgba(0,0,0,.4),
        inset 0 0 50px rgba(0,229,255,.02);

    backdrop-filter:blur(18px);

    transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;
}


.example-box:hover{

    transform:
        translateY(-5px);

    border-color:
        rgba(0,229,255,.42);

    box-shadow:
        0 35px 90px rgba(0,0,0,.45),
        0 0 35px rgba(0,229,255,.08);
}


.example-box::before{

    content:"EXAMPLE_MODULE";

    position:absolute;

    top:17px;
    right:20px;

    color:rgba(0,229,255,.35);

    font-family:monospace;

    font-size:9px;

    letter-spacing:2px;
}


.example-box::after{

    content:"";

    position:absolute;

    width:100px;
    height:100px;

    right:-45px;
    bottom:-45px;

    border:
        1px solid rgba(0,229,255,.18);

    transform:rotate(45deg);
}


.example-icon{

    width:64px;
    height:64px;

    display:grid;

    place-items:center;

    margin-bottom:24px;

    border:
        1px solid rgba(0,229,255,.28);

    border-radius:12px;

    background:
        rgba(0,229,255,.055);

    color:var(--cyan);

    font-size:27px;

    box-shadow:
        0 0 25px rgba(0,229,255,.08);

    animation:
        examplePulse 3s ease-in-out infinite;
}


@keyframes examplePulse{

    0%,100%{
        box-shadow:
            0 0 20px rgba(0,229,255,.06);
    }

    50%{
        box-shadow:
            0 0 35px rgba(0,229,255,.16);
    }
}


.example-label{

    margin-bottom:9px;

    color:var(--cyan);

    font-family:monospace;

    font-size:10px;

    font-weight:bold;

    letter-spacing:4px;
}


.example-box h2{

    padding-left:0;

    margin-bottom:15px;

    font-size:
        clamp(
            28px,
            3vw,
            40px
        );
}


.example-box h2::before,
.example-box h2::after{

    display:none;
}


.example-box p{

    margin-bottom:28px;

    color:#9eb6c5;

    font-size:15px;

    line-height:1.7;
}


/* =========================================================
   EXAMPLE BUTTON
   ========================================================= */

.example-btn{

    width:max-content;

    min-width:190px;

    padding:
        14px
        19px;

    border:
        1px solid rgba(0,229,255,.3);

    border-radius:5px;

    background:
        linear-gradient(
            90deg,
            rgba(22,140,255,.2),
            rgba(0,229,255,.08)
        );

    color:white;

    font-family:monospace;

    font-size:11px;

    font-weight:bold;

    letter-spacing:1.5px;

    cursor:pointer;

    position:relative;

    overflow:hidden;

    transition:
        .3s ease;
}


.example-btn::before{

    content:"";

    position:absolute;

    top:0;
    left:-100%;

    width:100%;
    height:100%;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.13),
            transparent
        );

    transition:
        .5s ease;
}


.example-btn:hover::before{

    left:100%;
}


.example-btn:hover{

    transform:
        translateY(-3px);

    color:var(--cyan);

    border-color:
        var(--cyan);

    background:
        rgba(0,229,255,.08);

    box-shadow:
        0 0 25px rgba(0,229,255,.12);
}


.example-btn span{

    margin-left:10px;

    color:var(--cyan);
}


/* =========================================================
   GLASS CARDS
   ========================================================= */

.glass{

    background:
        linear-gradient(
            145deg,
            rgba(10,25,41,.78),
            rgba(5,15,27,.7)
        );

    border:
        1px solid var(--border);

    border-radius:8px;

    backdrop-filter:blur(15px);

    box-shadow:
        var(--shadow),
        inset 0 1px rgba(255,255,255,.025);
}


/* =========================================================
   INFORMATION CARDS
   ========================================================= */

.info-card{

    padding:30px;

    position:relative;

    overflow:hidden;
}


.info-card::before{

    content:"";

    position:absolute;

    width:120px;
    height:1px;

    left:0;
    top:0;

    background:
        linear-gradient(
            90deg,
            var(--cyan),
            transparent
        );
}


.info-card h3{

    margin-bottom:14px;

    color:var(--cyan);

    font-family:monospace;

    font-size:18px;

    letter-spacing:2px;
}


.info-card p{

    font-size:16px;
}


/* =========================================================
   TWO COLUMN
   ========================================================= */

.two-column{

    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:25px;
}


/* =========================================================
   SMALL CARDS
   ========================================================= */

.cards{

    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:18px;
}


.small-card{

    padding:25px;

    position:relative;

    overflow:hidden;

    background:
        linear-gradient(
            145deg,
            rgba(10,27,44,.8),
            rgba(5,16,28,.72)
        );

    border:
        1px solid rgba(0,229,255,.11);

    border-radius:7px;

    transition:
        .3s ease;
}


.small-card::before{

    content:"";

    position:absolute;

    top:0;
    left:0;

    width:3px;
    height:0;

    background:
        linear-gradient(
            var(--cyan),
            var(--blue)
        );

    transition:
        .35s ease;
}


.small-card:hover{

    transform:
        translateY(-5px);

    border-color:
        rgba(0,229,255,.28);

    background:
        var(--panel-hover);

    box-shadow:
        0 20px 45px rgba(0,0,0,.3);
}


.small-card:hover::before{

    height:100%;
}


.small-card h3{

    margin-bottom:9px;

    color:var(--cyan);

    font-size:18px;
}


.small-card p{

    color:#9fb6c5;

    font-size:14px;

    line-height:1.7;
}


/* =========================================================
   DATA FLOW
   ========================================================= */

.data-flow{

    display:flex;

    align-items:center;

    justify-content:center;

    flex-wrap:wrap;

    gap:12px;

    margin-top:35px;

    padding:30px;

    border:
        1px solid rgba(0,229,255,.1);

    background:
        rgba(0,229,255,.018);

    border-radius:8px;
}


.flow-box{

    min-width:150px;

    padding:19px 22px;

    text-align:center;

    background:
        linear-gradient(
            145deg,
            rgba(10,29,46,.9),
            rgba(5,16,28,.8)
        );

    border:
        1px solid rgba(0,229,255,.2);

    border-radius:5px;

    color:#cfe1ea;

    transition:
        .3s ease;
}


.flow-box:hover{

    transform:
        translateY(-5px);

    border-color:
        var(--cyan);

    box-shadow:
        0 0 25px rgba(0,229,255,.08);
}


.flow-box strong{

    display:block;

    margin-bottom:6px;

    color:var(--cyan);

    font-family:monospace;

    font-size:12px;

    letter-spacing:2px;
}


.flow-arrow{

    color:var(--green);

    font-family:monospace;

    font-size:25px;

    text-shadow:
        0 0 10px rgba(0,255,157,.4);
}


/* =========================================================
   SYSTEM CARDS
   ========================================================= */

.system-cards{

    display:grid;

    grid-template-columns:
        repeat(5,minmax(0,1fr));

    gap:15px;
}


.system-card{

    min-height:210px;

    padding:25px 19px;

    text-align:center;

    position:relative;

    overflow:hidden;

    transition:
        .3s ease;
}


.system-card::before{

    content:"SYS";

    position:absolute;

    top:10px;
    right:12px;

    color:rgba(0,229,255,.12);

    font-family:monospace;

    font-size:8px;

    letter-spacing:2px;
}


.system-card:hover{

    transform:
        translateY(-7px);

    border-color:
        rgba(0,229,255,.35);

    box-shadow:
        0 25px 55px rgba(0,0,0,.35),
        0 0 25px rgba(0,229,255,.06);
}


.system-card h3{

    margin-bottom:12px;

    color:var(--cyan);

    font-family:monospace;

    font-size:19px;

    letter-spacing:2px;
}


.system-card p{

    color:#9fb5c3;

    font-size:13px;

    line-height:1.65;
}


.system-card .source{

    margin-top:14px;

    font-size:10px;
}


/* =========================================================
   STATS
   ========================================================= */

.stats{

    display:grid;

    grid-template-columns:
        repeat(5,minmax(0,1fr));

    gap:15px;

    margin-top:30px;
}


.stat{

    padding:23px;

    text-align:center;

    background:
        linear-gradient(
            145deg,
            rgba(8,27,44,.82),
            rgba(5,16,28,.7)
        );

    border:
        1px solid rgba(0,229,255,.12);

    border-radius:7px;

    transition:
        .3s ease;
}


.stat:hover{

    transform:
        translateY(-5px);

    border-color:
        rgba(0,229,255,.3);
}


.stat strong{

    display:block;

    margin-bottom:8px;

    color:var(--cyan);

    font-family:monospace;

    font-size:20px;

    letter-spacing:2px;
}


/* =========================================================
   DATABASE
   ========================================================= */

.database{

    max-width:750px;

    margin:35px auto;

    padding:25px;

    background:
        rgba(4,14,25,.82);

    border:
        1px solid rgba(0,229,255,.15);

    border-radius:6px;

    box-shadow:
        0 25px 60px rgba(0,0,0,.35);
}


.database-row{

    display:grid;

    grid-template-columns:
        1fr 2fr;

    gap:20px;

    padding:15px 8px;

    border-bottom:
        1px solid rgba(255,255,255,.055);

    color:#c8dbe5;
}


.database-row:last-child{

    border-bottom:none;
}


.database-key{

    color:var(--cyan);

    font-family:monospace;

    font-size:12px;

    font-weight:bold;

    letter-spacing:1px;
}


/* =========================================================
   VISUAL GRID
   ========================================================= */

.visual-grid{

    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:20px;
}


.visual-card{

    min-height:300px;

    overflow:hidden;

    position:relative;

    transition:
        .35s ease;
}


.visual-card:hover{

    transform:
        translateY(-7px);

    border-color:
        rgba(0,229,255,.3);

    box-shadow:
        0 30px 70px rgba(0,0,0,.4);
}


.visual-card img{

    width:100%;

    height:175px;

    object-fit:cover;

    display:block;

    cursor:pointer;

    opacity:.68;

    filter:
        saturate(.75)
        contrast(1.08);

    transition:
        .5s ease;
}


.visual-card:hover img{

    opacity:.9;

    filter:
        saturate(1)
        contrast(1.08);

    transform:
        scale(1.045);
}


.visual-card-content{

    padding:20px;
}


.visual-card-content h3{

    margin-bottom:7px;

    color:var(--cyan);

    font-size:19px;
}


.visual-card-content p{

    color:#9fb5c3;

    font-size:13px;

    line-height:1.65;
}


.visual-card-content .example-btn{

    min-width:110px;

    padding:
        9px
        13px;

    font-size:9px;
}


.image-badge{

    position:absolute;

    top:12px;
    left:12px;

    z-index:2;

    padding:
        6px
        10px;

    border:
        1px solid rgba(0,229,255,.25);

    border-radius:3px;

    background:
        rgba(2,8,15,.78);

    backdrop-filter:blur(8px);

    color:var(--cyan);

    font-family:monospace;

    font-size:9px;

    font-weight:bold;

    letter-spacing:2px;
}


/* =========================================================
   LIGHTBOX
   ========================================================= */

.lightbox{

    position:fixed;

    inset:0;

    display:none;

    align-items:center;

    justify-content:center;

    padding:40px;

    background:
        rgba(0,3,8,.9);

    backdrop-filter:blur(12px);

    z-index:5000;
}


.lightbox.active{

    display:flex;
}


.lightbox img{

    max-width:92%;

    max-height:86vh;

    border:
        1px solid rgba(0,229,255,.25);

    border-radius:7px;

    box-shadow:
        0 30px 100px rgba(0,0,0,.7),
        0 0 50px rgba(0,229,255,.08);
}


.lightbox-close{

    position:absolute;

    top:25px;
    right:30px;

    width:45px;
    height:45px;

    border:
        1px solid rgba(0,229,255,.2);

    border-radius:5px;

    background:
        rgba(5,17,29,.85);

    color:white;

    font-size:25px;

    cursor:pointer;

    transition:.25s;
}


.lightbox-close:hover{

    color:var(--cyan);

    border-color:var(--cyan);
}


/* =========================================================
   EXAMPLE MODAL
   ========================================================= */

.example-modal{

    position:fixed;

    inset:0;

    display:none;

    align-items:center;

    justify-content:center;

    padding:30px;

    z-index:6000;
}


.example-modal.active{

    display:flex;
}


.example-backdrop{

    position:absolute;

    inset:0;

    background:
        rgba(1,5,11,.9);

    backdrop-filter:
        blur(15px);
}


.example-panel{

    position:relative;

    width:
        min(920px,95vw);

    max-height:
        88vh;

    overflow-y:auto;

    padding:45px;

    background:
        radial-gradient(
            circle at 85% 5%,
            rgba(0,229,255,.1),
            transparent 30%
        ),
        linear-gradient(
            145deg,
            #081827,
            #040c16
        );

    border:
        1px solid rgba(0,229,255,.3);

    border-radius:8px;

    box-shadow:
        0 40px 120px rgba(0,0,0,.75),
        0 0 60px rgba(0,229,255,.08);

    animation:
        modalIn .35s ease;
}


@keyframes modalIn{

    from{
        opacity:0;
        transform:
            translateY(30px)
            scale(.97);
    }

    to{
        opacity:1;
        transform:
            translateY(0)
            scale(1);
    }
}


.example-panel::before{

    content:"LIVE_EXAMPLE // SYSTEM_FLOW";

    position:absolute;

    top:17px;
    left:25px;

    color:rgba(0,229,255,.35);

    font-family:monospace;

    font-size:8px;

    letter-spacing:2px;
}


.example-close{

    position:absolute;

    top:16px;
    right:18px;

    width:42px;
    height:42px;

    border:
        1px solid rgba(0,229,255,.16);

    border-radius:5px;

    background:
        rgba(255,255,255,.025);

    color:white;

    font-size:24px;

    cursor:pointer;

    transition:.25s;
}


.example-close:hover{

    color:var(--cyan);

    border-color:var(--cyan);

    box-shadow:
        0 0 20px rgba(0,229,255,.08);
}


.example-panel .example-label{

    margin-top:18px;
}


.example-panel h2{

    font-size:
        clamp(
            30px,
            4vw,
            48px
        );

    margin-bottom:20px;
}


.example-scenario{

    margin:
        20px 0
        25px;

    padding:22px 24px;

    border:
        1px solid rgba(0,229,255,.14);

    border-left:
        3px solid var(--cyan);

    border-radius:5px;

    background:
        rgba(0,229,255,.035);

    color:#cfe2ec;

    line-height:1.8;

    font-size:16px;
}


.example-steps{

    display:grid;

    gap:10px;

    margin-top:20px;
}


.example-step{

    display:grid;

    grid-template-columns:
        45px 1fr;

    gap:15px;

    align-items:center;

    padding:16px;

    border:
        1px solid rgba(0,229,255,.08);

    border-radius:5px;

    background:
        linear-gradient(
            90deg,
            rgba(0,229,255,.035),
            rgba(255,255,255,.012)
        );

    transition:
        .25s ease;
}


.example-step:hover{

    transform:
        translateX(5px);

    border-color:
        rgba(0,229,255,.2);

    background:
        rgba(0,229,255,.055);
}


.step-number{

    width:36px;
    height:36px;

    display:grid;

    place-items:center;

    border:
        1px solid rgba(0,229,255,.25);

    border-radius:5px;

    background:
        rgba(0,229,255,.055);

    color:var(--cyan);

    font-family:monospace;

    font-size:12px;

    font-weight:bold;
}


.example-step p{

    padding:0;

    margin:0;

    background:none;

    border:none;

    box-shadow:none;

    color:#bfd3de;

    font-size:14px;

    line-height:1.65;
}


.example-step p::before{

    display:none;
}


.example-result{

    margin-top:25px;

    padding:23px;

    border:
        1px solid rgba(0,255,157,.13);

    border-left:
        3px solid var(--green);

    border-radius:5px;

    background:
        rgba(0,255,157,.035);
}


.example-result strong{

    display:block;

    margin-bottom:8px;

    color:var(--green);

    font-family:monospace;

    font-size:11px;

    letter-spacing:3px;
}


.example-result p{

    padding:0;

    margin:0;

    background:none;

    border:none;

    box-shadow:none;

    color:#c6d9e2;

    font-size:15px;

}


.example-result p::before{

    display:none;
}


/* =========================================================
   REFERENCES
   ========================================================= */

.reference-list{

    display:grid;

    gap:12px;

    max-width:1050px;

    list-style:none;

    padding:0;

    margin:0;
}


.reference-list li{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    padding:20px 23px;

    margin:0;

    color:#c9dce6;

    font-size:15px;

    background:
        linear-gradient(
            90deg,
            rgba(0,229,255,.045),
            rgba(255,255,255,.012)
        );

    border:
        1px solid rgba(0,229,255,.1);

    border-left:
        2px solid rgba(0,229,255,.3);

    border-radius:4px;

    transition:.3s ease;
}


.reference-list li::before{

    display:none;
}


.reference-list li:hover{

    transform:
        translateX(6px);

    border-left-color:
        var(--cyan);

    border-color:
        rgba(0,229,255,.25);

    background:
        rgba(0,229,255,.06);
}


.reference-list a{

    color:var(--cyan);

    text-decoration:none;

    font-family:monospace;

    font-size:11px;

    font-weight:bold;

    letter-spacing:1px;

    white-space:nowrap;

    transition:.25s ease;
}


.reference-list a:hover{

    color:white;

    text-shadow:
        0 0 10px var(--cyan);
}


/* =========================================================
   FLOATING ICON
   ========================================================= */

.floating-icon{

    position:fixed;

    right:30px;
    bottom:30px;

    width:58px;
    height:58px;

    display:flex;

    align-items:center;

    justify-content:center;

    border:
        1px solid rgba(0,229,255,.3);

    border-radius:6px;

    background:
        rgba(0,229,255,.045);

    color:var(--cyan);

    font-size:24px;

    box-shadow:
        0 0 25px rgba(0,229,255,.08);

    animation:
        techFloat 4s ease-in-out infinite;

    z-index:1000;
}


@keyframes techFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-8px);
    }
}


/* =========================================================
   NAVBAR
   ========================================================= */

.navbar{

    position:fixed;

    top:0;
    left:0;

    width:100%;

    height:65px;

    display:flex;

    justify-content:center;

    align-items:center;

    gap:6px;

    padding:
        10px 20px;

    background:
        rgba(3,10,18,.9);

    backdrop-filter:
        blur(18px);

    -webkit-backdrop-filter:
        blur(18px);

    border-bottom:
        1px solid rgba(0,229,255,.15);

    box-shadow:
        0 5px 35px rgba(0,0,0,.4);

    z-index:1500;
}


.navbar::before{

    content:"SYSTEM ONLINE";

    position:absolute;

    left:25px;

    color:var(--green);

    font-family:monospace;

    font-size:10px;

    font-weight:bold;

    letter-spacing:2px;
}


.navbar a{

    color:#8eaabd;

    text-decoration:none;

    font-size:11px;

    font-weight:600;

    letter-spacing:.7px;

    padding:
        8px 12px;

    border:
        1px solid transparent;

    border-radius:4px;

    transition:.25s ease;
}


.navbar a:hover{

    color:var(--cyan);

    border-color:
        rgba(0,229,255,.25);

    background:
        rgba(0,229,255,.055);

    box-shadow:
        0 0 15px rgba(0,229,255,.08);
}


/* =========================================================
   PROGRESS
   ========================================================= */

.progress{

    position:fixed;

    top:64px;
    left:0;

    width:100%;

    height:3px;

    background:
        rgba(255,255,255,.035);

    z-index:1600;
}


.progress-bar{

    width:0%;

    height:100%;

    background:
        linear-gradient(
            90deg,
            var(--blue),
            var(--cyan),
            var(--green)
        );

    box-shadow:
        0 0 14px var(--cyan);

    transition:
        width .15s ease;
}


/* =========================================================
   NAVIGATION CONTROLS
   ========================================================= */

.controls{

    position:fixed;

    left:30px;
    bottom:25px;

    display:flex;

    gap:6px;

    z-index:1000;
}


.controls a,
.control-btn{

    width:40px;
    height:40px;

    display:flex;

    align-items:center;

    justify-content:center;

    text-decoration:none;

    color:#8ba4b7;

    background:
        rgba(5,17,29,.88);

    border:
        1px solid rgba(0,229,255,.15);

    border-radius:5px;

    font-size:17px;

    cursor:pointer;

    transition:.25s ease;
}


.controls a:hover,
.control-btn:hover{

    color:var(--cyan);

    border-color:var(--cyan);

    box-shadow:
        0 0 15px rgba(0,229,255,.15);

    transform:
        translateY(-3px);
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar{

    width:8px;
}


::-webkit-scrollbar-track{

    background:#02070c;
}


::-webkit-scrollbar-thumb{

    background:
        linear-gradient(
            var(--blue),
            var(--cyan)
        );

    border-radius:5px;
}


::-webkit-scrollbar-thumb:hover{

    background:var(--cyan);
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:1100px){

    .topic-layout{

        grid-template-columns:
            1fr;

        gap:35px;
    }


    .example-box{

        min-height:320px;
    }


    .system-cards{

        grid-template-columns:
            repeat(2,1fr);
    }


    .stats{

        grid-template-columns:
            repeat(2,1fr);
    }


    .visual-grid{

        grid-template-columns:
            repeat(2,1fr);
    }
}


@media(max-width:800px){

    .navbar{

        justify-content:flex-start;

        overflow-x:auto;

        white-space:nowrap;
    }


    .navbar::before{

        display:none;
    }


    .slide{

        padding:
            105px
            25px
            85px;
    }


    .two-column,
    .cards{

        grid-template-columns:
            1fr;
    }


    .visual-grid{

        grid-template-columns:
            1fr;
    }


    .definition{

        font-size:18px;

        padding:22px;
    }


    .example-panel{

        padding:
            35px
            22px;
    }


    .reference-list li{

        flex-direction:column;

        align-items:flex-start;
    }
}


@media(max-width:600px){

    .cover h1{

        font-size:52px;

        letter-spacing:-2px;
    }


    .cover-subtitle{

        font-size:16px;
    }


    h2{

        font-size:32px;

        padding-left:17px;
    }


    h2::after{

        font-size:8px;

        letter-spacing:2px;
    }


    .system-cards,
    .stats{

        grid-template-columns:
            1fr;
    }


    .data-flow{

        flex-direction:column;
    }


    .flow-arrow{

        transform:rotate(90deg);
    }


    .example-step{

        grid-template-columns:
            36px 1fr;

        padding:13px;
    }


    .floating-icon{

        right:15px;
        bottom:15px;

        width:48px;
        height:48px;
    }


    .controls{

        left:15px;
        bottom:15px;
    }
}